<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="G3M.Settings.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="880" HorizontalAlignment="Left">

            <!-- 三个大数字 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="18"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="当前 DPI" Opacity="0.7" FontSize="12" />
                        <TextBlock x:Name="DpiValue" Text="—" FontSize="32" FontWeight="SemiBold" />
                        <TextBlock x:Name="DpiDetail" Text="等待设备" Opacity="0.7" FontSize="12" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="18"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="回报率" Opacity="0.7" FontSize="12" />
                        <TextBlock x:Name="RateValue" Text="—" FontSize="32" FontWeight="SemiBold" />
                        <TextBlock Text="Hz" Opacity="0.7" FontSize="12" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="18"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="电量" Opacity="0.7" FontSize="12" />
                        <TextBlock x:Name="BatteryValue" Text="—" FontSize="32" FontWeight="SemiBold" />
                        <TextBlock x:Name="BatteryDetail" Text="等待设备" Opacity="0.7" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DPI 档位快切 -->
            <Border
                Padding="18"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="DPI 档位" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="StageHint"
                            Text="选择后写入板载配置"
                            Opacity="0.7"
                            FontSize="12" />
                    </StackPanel>

                    <StackPanel x:Name="StageButtons" Orientation="Horizontal" Spacing="8" />

                    <ItemsControl x:Name="StageValues">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 设备信息 -->
            <Border
                Padding="18"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="设备信息" FontSize="16" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="16" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="连接方式" Opacity="0.7" />
                        <TextBlock x:Name="ConnectionValue" Grid.Row="0" Grid.Column="1" Text="—" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="传感器" Opacity="0.7" />
                        <TextBlock x:Name="SensorValue" Grid.Row="1" Grid.Column="1" Text="—" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="DPI 步进" Opacity="0.7" />
                        <TextBlock x:Name="StepValue" Grid.Row="2" Grid.Column="1" Text="—" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="配置编号" Opacity="0.7" />
                        <TextBlock x:Name="ProfileValue" Grid.Row="3" Grid.Column="1" Text="—" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
