<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="G3M.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 根 Grid 不设 Background：只要有任何一层不透明背景，云母就会被整块盖住。 -->
    <Grid x:Name="RootGrid">

        <!-- NavigationView 默认会自己画一层不透明背景，必须逐个覆盖成透明，
             否则 MicaBackdrop 设了也看不见。 -->
        <Grid.Resources>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏。内容延伸进标题栏之后系统不再画它，
             底下的材质可以直接透上来，按钮颜色也能精确跟随主题。 -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="36"
            Background="Transparent">
            <StackPanel
                Margin="16,0,0,0"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
                <FontIcon
                    FontSize="14"
                    Glyph="&#xE7C9;"
                    Opacity="0.85" />
                <TextBlock
                    x:Name="TitleText"
                    Text="G3M Controller"
                    FontSize="12"
                    Opacity="0.9" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="188"
            SelectionChanged="OnSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Icon="Home" Tag="overview" />
                <NavigationViewItem Content="性能" Icon="Zoom" Tag="performance" />
                <NavigationViewItem Content="高级" Icon="Setting" Tag="advanced" />
                <NavigationViewItem Content="按键" Icon="Keyboard" Tag="buttons" />
                <NavigationViewItem Content="电量" Icon="Clock" Tag="battery" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Background="Transparent" />
        </NavigationView>

        <!-- 状态条固定在底部 -->
        <Border
            Grid.Row="2"
            Padding="16,10"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Glyph="&#xE7C9;" />

                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="正在检测设备…"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        x:Name="BusyRing"
                        Width="18"
                        Height="18"
                        IsActive="False" />
                    <Button
                        x:Name="RefreshButton"
                        Click="OnRefreshClicked"
                        Content="刷新" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
